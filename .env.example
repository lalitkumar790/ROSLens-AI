# Optional OpenAI-compatible endpoint (the app appends /chat/completions)
# Ollama local: http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=45
MAX_LOG_CHARS=20000
MAX_IMAGE_BYTES=5242880
# auto detects Ollama URLs; choose "ollama" or "openai" to override
LLM_VISION_FORMAT=auto
